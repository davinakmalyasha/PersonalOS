{
  "name": "personal-os",
  "private": true,
  "version": "0.1.0",
  "description": "Personal OS — local-first life platform for humans and agents",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint": "npm --workspaces run lint --if-present",
    "typecheck": "npm --workspaces run typecheck --if-present",
    "test": "echo \"use go test ./... for API tests\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "next": "^16.3.2"
  }
}
