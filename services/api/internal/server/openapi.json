{
  "openapi": "3.1.0",
  "info": {
    "title": "Personal OS API",
    "version": "0.3.0",
    "description": "Local-first personal platform. Phase 3: Planner module live (tasks, habits + checkoffs with streaks, events with RRULE-lite recurrence, today/upcoming/overview bundles) alongside Phase 2 Finance."
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "local dev" }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "Healthz": {
        "type": "object",
        "required": ["status", "db"],
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "db": { "type": "string", "example": "ok" }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["checking", "savings", "cash", "card", "wallet"] },
          "currency": { "type": "string" },
          "created_at": { "type": "string" },
          "balance_minor": { "type": "integer", "description": "sum of signed transaction amounts" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "account_id": { "type": "string" },
          "amount_minor": { "type": "integer", "description": "signed; spend negative, income positive" },
          "currency": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "merchant": { "type": "string" },
          "raw_description": { "type": "string" },
          "category_id": { "type": ["string", "null"] },
          "category_name": { "type": ["string", "null"] },
          "notes": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "CategoryNode": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "parent_id": { "type": ["string", "null"] },
          "color": { "type": ["string", "null"] },
          "created_at": { "type": "string" },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/CategoryNode" } }
        }
      },
      "Rule": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "pattern": { "type": "string" },
          "category_id": { "type": "string" },
          "priority": { "type": "integer" },
          "created_at": { "type": "string" }
        }
      },
      "Budget": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category_id": { "type": "string" },
          "category": { "type": "string" },
          "month": { "type": "string", "example": "2026-08" },
          "amount_minor": { "type": "integer" }
        }
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "imported": { "type": "integer" },
          "skipped": { "type": "integer", "description": "duplicates by (date, amount, description-hash)" },
          "skipped_invalid": { "type": "integer" },
          "auto_categorized": { "type": "integer" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": { "type": "integer" },
                "message": { "type": "string" }
              }
            }
          }
        }
      },
      "MonthSummary": {
        "type": "object",
        "properties": {
          "month": { "type": "string" },
          "income_minor": { "type": "integer" },
          "outcome_minor": { "type": "integer" },
          "net_minor": { "type": "integer" },
          "by_category": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category_id": { "type": "string" },
                "name": { "type": "string" },
                "spent_minor": { "type": "integer" }
              }
            }
          },
          "budgets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category_id": { "type": "string" },
                "category_name": { "type": "string" },
                "budget_minor": { "type": "integer" },
                "spent_minor": { "type": "integer" },
                "over": { "type": "boolean" }
              }
            }
          }
        }
      },
      "SpendingSeries": {
        "type": "object",
        "properties": {
          "group_by": { "type": "string", "enum": ["month", "category"] },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "spent_minor": { "type": "integer" }
              }
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "notes": { "type": "string" },
          "status": { "type": "string", "enum": ["todo", "doing", "done"] },
          "priority": { "type": "string", "enum": ["low", "med", "high"] },
          "due_date": { "type": ["string", "null"], "format": "date" },
          "project": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "completed_at": { "type": ["string", "null"] }
        }
      },
      "HabitStreaks": {
        "type": "object",
        "properties": {
          "current": { "type": "integer", "description": "consecutive days (daily) or target-meeting weeks (weekly)" },
          "longest": { "type": "integer" },
          "done_today": { "type": "boolean" },
          "week_done": { "type": "integer" },
          "target_per_week": { "type": "integer" }
        }
      },
      "Habit": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "cadence": { "type": "string", "enum": ["daily", "weekly"] },
          "target_per_week": { "type": "integer", "minimum": 1, "maximum": 7 },
          "color": { "type": ["string", "null"] },
          "created_at": { "type": "string" },
          "archived_at": { "type": ["string", "null"] },
          "streaks": { "$ref": "#/components/schemas/HabitStreaks" }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": ["string", "null"], "format": "date-time" },
          "location": { "type": "string" },
          "recurrence_rule": {
            "type": ["string", "null"],
            "description": "RRULE-lite: FREQ=DAILY|WEEKLY|MONTHLY;INTERVAL=n;COUNT=n|UNTIL=YYYYMMDD"
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Occurrence": {
        "type": "object",
        "properties": {
          "event_id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "date": { "type": "string", "format": "date" },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": "string", "format": "date-time" },
          "series": { "type": "boolean" }
        }
      },
      "TodayBundle": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "overdue": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } },
          "due_today": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } },
          "habits": {
            "type": "array",
            "items": {
              "type": "object",
              "allOf": [
                { "$ref": "#/components/schemas/Habit" },
                {
                  "type": "object",
                  "properties": {
                    "due_today": { "type": "boolean" },
                    "done_today": { "type": "boolean" }
                  }
                }
              ]
            }
          },
          "events": { "type": "array", "items": { "$ref": "#/components/schemas/Occurrence" } }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "summary": "Liveness + DB ping",
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Healthz" } } }
          },
          "503": { "description": "db unavailable" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "Canonical OpenAPI spec",
        "responses": { "200": { "description": "spec" } }
      }
    },
    "/v1/accounts": {
      "post": {
        "operationId": "createAccount",
        "summary": "Create account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "enum": ["checking", "savings", "cash", "card", "wallet"] },
                  "currency": { "type": "string", "default": "IDR" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Account" } } } }, "409": { "description": "duplicate name" } }
      },
      "get": {
        "operationId": "listAccounts",
        "summary": "List accounts with balances",
        "responses": { "200": { "description": "list", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } } } } } } } }
      }
    },
    "/v1/accounts/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "operationId": "getAccount", "summary": "Get account", "responses": { "200": { "description": "ok" }, "404": { "description": "missing" } } },
      "patch": { "operationId": "updateAccount", "summary": "Update name/type", "responses": { "200": { "description": "ok" } } },
      "delete": { "operationId": "deleteAccount", "summary": "Delete (blocks when transactions exist)", "responses": { "204": { "description": "deleted" }, "409": { "description": "has transactions" } } }
    },
    "/v1/transactions": {
      "get": {
        "operationId": "listTransactions",
        "summary": "List transactions (filter/search/paginate)",
        "parameters": [
          { "name": "account_id", "in": "query", "schema": { "type": "string" } },
          { "name": "category_id", "in": "query", "schema": { "type": "string" }, "description": "'none' = uncategorized only" },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "min", "in": "query", "schema": { "type": "integer" } },
          { "name": "max", "in": "query", "schema": { "type": "integer" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "paged list", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } }, "total": { "type": "integer" }, "page": { "type": "integer" }, "page_size": { "type": "integer" } } } } } } }
      },
      "post": {
        "operationId": "createTransaction",
        "summary": "Create a transaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["account_id", "amount_minor", "date"],
                "properties": {
                  "account_id": { "type": "string" },
                  "amount_minor": { "type": "integer" },
                  "date": { "type": "string", "format": "date" },
                  "merchant": { "type": "string" },
                  "raw_description": { "type": "string" },
                  "category_id": { "type": ["string", "null"] },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" }, "409": { "description": "duplicate natural key" } }
      }
    },
    "/v1/transactions/import": {
      "post": {
        "operationId": "importTransactionsCsv",
        "summary": "Import bank CSV: auto-detect columns (EN/ID), dedupe by (date, amount, hash), auto-categorize via rules",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "account_id"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "account_id": { "type": "string" },
                  "currency": { "type": "string", "default": "IDR" },
                  "date_format": { "type": "string", "description": "Go layout override, e.g. 02/01/2006" },
                  "date_col": { "type": "integer" },
                  "desc_col": { "type": "integer" },
                  "amount_col": { "type": "integer" },
                  "debit_col": { "type": "integer" },
                  "credit_col": { "type": "integer" },
                  "merchant_col": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportResult" } } } }
        }
      }
    },
    "/v1/transactions/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "operationId": "getTransaction", "summary": "Get transaction", "responses": { "200": { "description": "ok" }, "404": { "description": "missing" } } },
      "patch": {
        "operationId": "updateTransaction",
        "summary": "Update (category override persists; raw_description change recomputes dedupe hash)",
        "responses": { "200": { "description": "ok" }, "409": { "description": "natural key collision" } }
      },
      "delete": { "operationId": "deleteTransaction", "summary": "Delete transaction", "responses": { "204": { "description": "deleted" } } }
    },
    "/v1/categories": {
      "get": { "operationId": "listCategories", "summary": "Category tree", "responses": { "200": { "description": "tree", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/CategoryNode" } } } } } } } } },
      "post": {
        "operationId": "createCategory",
        "summary": "Create category",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "parent_id": { "type": ["string", "null"] },
                  "color": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" }, "409": { "description": "duplicate name under parent" } }
      }
    },
    "/v1/categories/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
        { "name": "reassign_to", "in": "query", "schema": { "type": "string" }, "description": "delete: move transactions to this category instead of blocking" }
      ],
      "patch": { "operationId": "updateCategory", "summary": "Update / reparent", "responses": { "200": { "description": "ok" }, "400": { "description": "cycle rejected" } } },
      "delete": { "operationId": "deleteCategory", "summary": "Delete (blocks on children/usage unless reassign_to)", "responses": { "204": { "description": "deleted" }, "409": { "description": "referenced" } } }
    },
    "/v1/rules": {
      "get": { "operationId": "listRules", "summary": "Rules ordered by priority", "responses": { "200": { "description": "list" } } },
      "post": {
        "operationId": "createRule",
        "summary": "Create categorization rule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pattern", "category_id"],
                "properties": {
                  "pattern": { "type": "string" },
                  "category_id": { "type": "string" },
                  "priority": { "type": "integer", "default": 100 }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/v1/rules/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "patch": { "operationId": "updateRule", "summary": "Update rule / reorder", "responses": { "200": { "description": "ok" } } },
      "delete": { "operationId": "deleteRule", "summary": "Delete rule", "responses": { "204": { "description": "deleted" } } }
    },
    "/v1/budgets": {
      "get": { "operationId": "listBudgets", "summary": "List budgets", "parameters": [
        { "name": "from", "in": "query", "schema": { "type": "string", "example": "2026-01" } },
        { "name": "to", "in": "query", "schema": { "type": "string" } }
      ], "responses": { "200": { "description": "list" } } },
      "post": {
        "operationId": "upsertBudget",
        "summary": "Upsert budget for (category, month)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["category_id", "month", "amount_minor"],
                "properties": {
                  "category_id": { "type": "string" },
                  "month": { "type": "string", "example": "2026-08" },
                  "amount_minor": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "upserted" } }
      }
    },
    "/v1/budgets/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "delete": { "operationId": "deleteBudget", "summary": "Delete budget", "responses": { "204": { "description": "deleted" } } }
    },
    "/v1/finance/summary": {
      "get": {
        "operationId": "financeSummary",
        "summary": "Month totals, category rollup, budget-vs-spent",
        "parameters": [{ "name": "month", "in": "query", "required": true, "schema": { "type": "string", "example": "2026-08" } }],
        "responses": { "200": { "description": "summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MonthSummary" } } } } }
      }
    },
    "/v1/finance/spending": {
      "get": {
        "operationId": "financeSpending",
        "summary": "Spending time series or breakdown",
        "parameters": [
          { "name": "group_by", "in": "query", "schema": { "type": "string", "enum": ["month", "category"], "default": "month" } },
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "series", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SpendingSeries" } } } } }
      }
    },
    "/v1/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "List tasks (filter/search/paginate)",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["open", "todo", "doing", "done"] }, "description": "'open' = todo+doing" },
          { "name": "priority", "in": "query", "schema": { "type": "string", "enum": ["low", "med", "high"] } },
          { "name": "due", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "due_before", "in": "query", "schema": { "type": "string", "format": "date" }, "description": "due on/before date (overdue scans)" },
          { "name": "project", "in": "query", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "schema": { "type": "integer", "default": 100, "maximum": 100 } }
        ],
        "responses": { "200": { "description": "paged list", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Task" } }, "total": { "type": "integer" }, "page": { "type": "integer" }, "page_size": { "type": "integer" } } } } } } }
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create task (quick capture)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "notes": { "type": "string" },
                  "status": { "type": "string", "enum": ["todo", "doing", "done"], "default": "todo" },
                  "priority": { "type": "string", "enum": ["low", "med", "high"], "default": "med" },
                  "due_date": { "type": "string", "format": "date" },
                  "project": { "type": "string" },
                  "tags": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Task" } } } }, "400": { "description": "validation error" } }
      }
    },
    "/v1/tasks/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "operationId": "getTask", "summary": "Get task", "responses": { "200": { "description": "ok" }, "404": { "description": "missing" } } },
      "patch": {
        "operationId": "updateTask",
        "summary": "Update task; status=done stamps completed_at, reopening clears it. Empty due_date/project clears the field.",
        "responses": { "200": { "description": "ok" }, "400": { "description": "invalid status/priority/date" }, "404": { "description": "missing" } }
      },
      "delete": { "operationId": "deleteTask", "summary": "Delete task", "responses": { "204": { "description": "deleted" } } }
    },
    "/v1/habits": {
      "get": {
        "operationId": "listHabits",
        "summary": "List habits with computed streaks",
        "parameters": [{ "name": "archived", "in": "query", "schema": { "type": "string", "enum": ["all"] }, "description": "'all' includes archived" }],
        "responses": { "200": { "description": "list", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Habit" } } } } } } } }
      },
      "post": {
        "operationId": "createHabit",
        "summary": "Create habit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "cadence": { "type": "string", "enum": ["daily", "weekly"], "default": "daily" },
                  "target_per_week": { "type": "integer", "minimum": 1, "maximum": 7 },
                  "color": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Habit" } } } }, "400": { "description": "validation error" } }
      }
    },
    "/v1/habits/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "operationId": "getHabit",
        "summary": "Get habit with streaks + full checkoff dates",
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Habit" } } } }, "404": { "description": "missing" } }
      },
      "patch": {
        "operationId": "updateHabit",
        "summary": "Update habit / archive via {archived: bool}",
        "responses": { "200": { "description": "ok" }, "404": { "description": "missing" } }
      },
      "delete": { "operationId": "deleteHabit", "summary": "Delete habit (cascades checkoffs)", "responses": { "204": { "description": "deleted" } } }
    },
    "/v1/habits/{id}/checkoffs": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "post": {
        "operationId": "toggleCheckoff",
        "summary": "Toggle checkoff for a date (insert when missing, remove when present). Returns new state + streaks.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "date": { "type": "string", "format": "date", "description": "default: today UTC" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "{habit_id, date, done, streaks}" }, "404": { "description": "missing habit" } }
      },
      "get": {
        "operationId": "listCheckoffs",
        "summary": "Checkoff dates in window",
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "dates descending", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "string", "format": "date" } } } } } } } }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "Occurrences between from/to — recurring events expanded at read time (RRULE-lite)",
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "occurrences", "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Occurrence" } } } } } } } }
      },
      "post": {
        "operationId": "createEvent",
        "summary": "Create event (single or recurring)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "starts_at"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "starts_at": { "type": "string", "format": "date-time" },
                  "ends_at": { "type": "string", "format": "date-time" },
                  "location": { "type": "string" },
                  "recurrence_rule": { "type": "string", "example": "FREQ=WEEKLY" },
                  "tags": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } } }, "400": { "description": "bad starts_at or recurrence_rule (unknown tokens rejected)" } }
      }
    },
    "/v1/events/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": { "operationId": "getEvent", "summary": "Get event series definition", "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } } }, "404": { "description": "missing" } } },
      "patch": { "operationId": "updateEvent", "summary": "Update event (edits whole series)", "responses": { "200": { "description": "ok" }, "400": { "description": "invalid fields" } } },
      "delete": { "operationId": "deleteEvent", "summary": "Delete event series", "responses": { "204": { "description": "deleted" } } }
    },
    "/v1/planner/today": {
      "get": {
        "operationId": "plannerToday",
        "summary": "Tasks due today + overdue + habits (due/done state) + today's event occurrences",
        "responses": { "200": { "description": "bundle", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TodayBundle" } } } } }
      }
    },
    "/v1/planner/upcoming": {
      "get": {
        "operationId": "plannerUpcoming",
        "summary": "Per-day agenda for the next N days",
        "parameters": [{ "name": "days", "in": "query", "schema": { "type": "integer", "default": 7, "maximum": 60 } }],
        "responses": { "200": { "description": "days with tasks + events" } }
      }
    },
    "/v1/planner/overview": {
      "get": {
        "operationId": "plannerOverview",
        "summary": "Unified daily bundle: tasks on date + habits state + occurrences",
        "parameters": [{ "name": "date", "in": "query", "schema": { "type": "string", "format": "date", "description": "default: today UTC" } }],
        "responses": { "200": { "description": "day bundle" }, "400": { "description": "bad date" } }
      }
    }
  }
}
