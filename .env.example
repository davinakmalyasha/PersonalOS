# Personal OS — environment template
# Copy to .env and fill values:  cp .env.example .env

# ---- API ----
PORT=8080
DB_PATH=./data/personal-os.db
LOG_LEVEL=info          # debug | info | warn | error
API_TOKEN=              # bearer token for API + MCP; empty = no auth (dev only)

# ---- Dashboard ----
# NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- LLM (optional, for future briefs) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=        # override for compatible gateways

# ---- Webhooks (optional; consumed by the scheduler) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# ---- Scheduler (phase 11) ----
# API_URL=http://localhost:8080   # where the Go API lives (compose: http://api:8080)
SCHED_INTERVAL_SECONDS=21600     # tick period (default 6h)
SCHED_RUN_HOUR=2                 # UTC hour for the nightly pass; empty = run every tick
SCHED_RUN_ON_START=false         # fire a pass immediately on boot
